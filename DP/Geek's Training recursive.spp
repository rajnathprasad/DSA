class Solution {
  public:
    int solve(int day, int last, vector<vector<int>> &mat){
        if(day==0){
            int maxi=0;
            for(int activity=0;activity<3;activity++){
                if(activity!=last){
                    maxi=max(maxi, mat[0][activity]);
                }
            }
            return maxi;
        }
        int maxi=0;
        for(int activity=0;activity<3;activity++){
            if(activity!=last){
                int curr=mat[day][activity] + solve(day-1, activity, mat);
                maxi=max(maxi, curr);
            }
        }
        return maxi;
    }
    int maximumPoints(vector<vector<int>>& mat) {
        // code here
        int n=mat.size();
        return solve(n-1, 3, mat);
    }
};